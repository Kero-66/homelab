# Caddyfile for TrueNAS Homelab
# This configuration uses custom domain names (e.g., .home) for local services
# Requires AdGuard Home DNS with local DNS entries pointing to 192.168.20.22
#
# All .home domains should resolve to 192.168.20.22 in AdGuard Home local DNS

# Global options
{
	# Enable admin API for health checks
	admin :2019
}

# Homepage Dashboard
http://homepage.home {
	reverse_proxy homepage:3000
}

# Jellyfin Media Server
http://jellyfin.home {
	reverse_proxy jellyfin:8096
}

# Jellyseerr Media Requests
http://jellyseerr.home {
	reverse_proxy jellyseerr:5055
}

# Jellystat Analytics
http://jellystat.home {
	reverse_proxy jellystat:3000
}

# Sonarr (TV Shows) - note the /sonarr URL base
http://sonarr.home {
	reverse_proxy sonarr:8989
}

# Radarr (Movies) - note the /radarr URL base
http://radarr.home {
	reverse_proxy radarr:7878
}

# Prowlarr (Indexers)
http://prowlarr.home {
	reverse_proxy prowlarr:9696
}

# SigNoz (Observability - metrics, logs, traces)
# Proxies to the host-exposed port, NOT the container DNS name — Caddy
# intentionally does not join signoz-network, since that network's
# ClickHouse has an unauthenticated admin default user (Foundry vendor
# default, network-scoped) and Caddy shouldn't be exposed to it.
http://signoz.home {
	reverse_proxy 192.168.20.22:3301
}

# Grafana (Observability trial 2 - Loki logs + Prometheus metrics via Alloy)
# Proxies to the host-exposed port, same pattern as signoz.home above —
# Caddy doesn't join grafana-alloy-network to avoid unnecessary coupling.
http://grafana.home {
	reverse_proxy 192.168.20.22:3010
}

# Bazarr (Subtitles) - note the /bazarr URL base
http://bazarr.home {
	reverse_proxy bazarr:6767
}

# qBittorrent (Torrents)
http://qbittorrent.home {
	reverse_proxy qbittorrent:8080
}

# SABnzbd (Usenet)
http://sabnzbd.home {
	reverse_proxy sabnzbd:8080
}

# AdGuard Home (DNS Admin)
http://adguard.home {
	reverse_proxy 192.168.20.22:3080
}

# Cleanuparr (Queue Cleaner)
http://cleanuparr.home {
	reverse_proxy cleanuparr:11011
}

# FlareSolverr (CAPTCHA Solver)
http://flaresolverr.home {
	reverse_proxy flaresolverr:8191
}

# Recyclarr (TRaSH Guides Sync)
# No web UI - API only

# Commafeed (RSS Reader)
http://rss.home {
	reverse_proxy 192.168.20.22:8088
}

# TrueNAS (Admin Interface) - redirect to HTTPS
truenas.home {
	redir https://192.168.20.22{uri} permanent
}

# FileFlows (Media Processing)
http://fileflows.home {
	reverse_proxy 192.168.20.22:19200
}

# JetKVM (KVM over IP)
http://jetkvm.home {
	reverse_proxy 192.168.20.25:80
}

# Dockhand (Container Update Manager)
http://dockhand.home {
	reverse_proxy 192.168.20.22:30328
}

# autobrr (Release automation)
http://autobrr.home {
	reverse_proxy autobrr:7474
}

# SuggestArr (Watch-history based recommendations)
http://suggestarr.home {
	reverse_proxy 192.168.20.22:5000
}

# Maintainerr (Watched-media cleanup automation)
http://maintainerr.home {
	reverse_proxy 192.168.20.22:6246
}

# Shoko (Anime Library Management)
http://shoko.home {
	reverse_proxy shoko_server:8111
}

# Infisical (Secret Manager)
http://infisical.home {
	redir / /login 302
	reverse_proxy 192.168.20.22:8081 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
