# Sportarr stack secrets - rendered by Infisical Agent
# DO NOT EDIT - this file is auto-generated every 5 minutes
# Source: Infisical project, dev environment, /media path
#
# Sportarr's own API key (for the homepage widget, once one exists) is
# generated by Sportarr itself on first boot (Settings > General), same as
# Sonarr/Radarr/Bazarr — add SPORTARR_API_KEY to Infisical /media after that
# first boot, this template is already wired to pick it up.
# Prowlarr key lets Sportarr sync indexers the same way Sonarr/Radarr do.

{{- with secret "5086c25c-310d-4cfb-9e2c-24d1fa92c152" "dev" "/media" }}
{{- range . }}
{{- if eq .Key "SPORTARR_API_KEY" }}
SPORTARR_API_KEY={{ .Value }}
{{- end }}
{{- if eq .Key "PROWLARR_API_KEY" }}
PROWLARR_API_KEY={{ .Value }}
{{- end }}
{{- end }}
{{- end }}
