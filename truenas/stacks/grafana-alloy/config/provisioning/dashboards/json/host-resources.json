{
  "title": "Host Resources",
  "uid": "homelab-host-resources",
  "description": "Whole-host CPU/memory/load and per-device disk I/O, from prometheus.exporter.unix (added 2026-09-10 alongside the Valheim server prep). Complements Container Rightsizing, which only covers per-container metrics via cAdvisor. Disk I/O panel exists specifically to confirm the slow 'Data' HDD pool (sda/sdb) stays idle - Valheim and this monitoring stack both live on the 'Fast' NVMe pool (nvme0n1/nvme2n1) only. See truenas/HARDWARE_CONFIG.md for the device-to-pool mapping.",
  "editable": true,
  "schemaVersion": 39,
  "tags": ["homelab", "resources", "host"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Host CPU busy",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "max": 100, "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }
          ]}
        },
        "overrides": []
      },
      "options": { "graphMode": "area" }
    },
    {
      "id": 2,
      "title": "Load average (1m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "Compare against machine_cpu_cores on the Container Rightsizing dashboard - sustained load above core count means the host is oversubscribed.",
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "node_load1" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 }, "overrides": [] },
      "options": { "graphMode": "area" }
    },
    {
      "id": 3,
      "title": "Memory available",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "max": 100, "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 10 }, { "color": "green", "value": 25 }
          ]}
        },
        "overrides": []
      },
      "options": { "graphMode": "area" }
    },
    {
      "id": 100, "title": "CPU & Load", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false, "panels": []
    },
    {
      "id": 4,
      "title": "CPU busy % over time",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100", "legendFormat": "CPU busy %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Load average (1m / 5m / 15m)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "node_load1", "legendFormat": "1m" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "node_load5", "legendFormat": "5m" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" }, "expr": "node_load15", "legendFormat": "15m" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 101, "title": "Disk I/O - Fast (NVMe) vs Data (HDD, slow)", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false, "panels": []
    },
    {
      "id": 6,
      "title": "Fast pool (nvme0n1, nvme2n1) - read/write bytes per sec",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "Where Valheim's world saves and this monitoring stack's own data live. Expected to carry the load.",
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(node_disk_read_bytes_total{device=~\"nvme0n1|nvme2n1\"}[5m])", "legendFormat": "{{device}} read" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(node_disk_written_bytes_total{device=~\"nvme0n1|nvme2n1\"}[5m])", "legendFormat": "{{device}} write" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Data pool (sda, sdb) - read/write bytes per sec - SHOULD STAY NEAR-IDLE",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "Valheim and grafana-alloy deliberately do not use this pool - any sustained non-zero traffic here that isn't normal media/library activity means something was misconfigured onto the slow disks.",
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(node_disk_read_bytes_total{device=~\"sda|sdb\"}[5m])", "legendFormat": "{{device}} read" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(node_disk_written_bytes_total{device=~\"sda|sdb\"}[5m])", "legendFormat": "{{device}} write" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 102, "title": "Filesystem Usage", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false, "panels": []
    },
    {
      "id": 8,
      "title": "Filesystem used % by mountpoint",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=~\"/mnt/Fast|/mnt/Data|/\"} / node_filesystem_size_bytes{mountpoint=~\"/mnt/Fast|/mnt/Data|/\"}) * 100",
          "legendFormat": "{{mountpoint}}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }
          ]}
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    }
  ]
}
