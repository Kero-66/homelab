// ###############################
// #### Metrics Configuration ####
// ###############################

// Configure a prometheus.remote_write component to send metrics to a Prometheus server.
prometheus.remote_write "demo" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Standalone cAdvisor (2026-09-11, see ai/OBSERVABILITY.md) - replaced the old
// prometheus.exporter.cadvisor Alloy component, which embeds a Grafana fork stuck on an old
// cAdvisor base that caches container_health_state at discovery and never refreshes it. This
// is a real ghcr.io/google/cadvisor:latest container (see compose.yaml, fix landed upstream in
// v0.60.5+), which re-inspects health every housekeeping cycle. Job label kept distinct in case
// anything else scrapes cadvisor.
// instance = "truenas" (a fixed literal, not constants.hostname) throughout this file - found
// live 2026-09-12: constants.hostname is the Alloy CONTAINER's own hostname, which changes on
// every recreate (new container ID). That churned the `instance` label on every metric series
// scraped through Alloy every time this stack deployed, causing duplicate/stale series and
// dashboards flapping between "no data" (querying the now-orphaned old label) and real data
// (once the new one had enough samples) - the ZFS Pool state panel's flapping was this bug, not
// a real data problem. These metrics describe the TrueNAS HOST (via /rootproc, /sys, /rootfs
// bind mounts) or other fixed on-host targets, not the Alloy container itself, so a fixed
// hostname is the correct label regardless of which Alloy container happens to be running it.
discovery.relabel "cadvisor_standalone" {
    targets = [{
      __address__ = "grafana-alloy-cadvisor:8080",
    }]

    rule {
        target_label = "job"
        replacement  = "cadvisor-standalone"
    }

    rule {
        target_label = "instance"
        replacement  = "truenas"
    }
}

prometheus.scrape "cadvisor_standalone" {
  targets    = discovery.relabel.cadvisor_standalone.output
  forward_to = [ prometheus.remote_write.demo.receiver ]

  scrape_interval = "10s"
}

// Scrape Dockhand's own Prometheus metrics (EXPORT_METRICS=true, enabled 2026-09-09 -
// see ai/OBSERVABILITY.md). Environment-level aggregates only (containers by
// state/health, restart counts, pending updates, vulnerabilities, Dockhand internals) -
// no per-container name label, so this complements cAdvisor rather than replacing it.
// Bearer token rendered by infisical-agent into grafana-alloy/.env (DOCKHAND_METRICS_TOKEN),
// read here via sys.env() - never hardcode it in this file.
prometheus.scrape "dockhand" {
  targets = [{
    __address__ = "192.168.20.22:30328",
  }]
  metrics_path = "/metrics"
  scheme       = "http"

  authorization {
    type        = "Bearer"
    credentials = sys.env("DOCKHAND_METRICS_TOKEN")
  }

  forward_to      = [ prometheus.remote_write.demo.receiver ]
  scrape_interval = "30s"
}

// Host-level metrics (CPU, memory, load average, per-device disk I/O, per-mountpoint
// filesystem usage) - added 2026-09-10 alongside the Valheim game server prep, which is
// expected to be the single heaviest CPU consumer on this host (see ai/OBSERVABILITY.md).
// cAdvisor above only covers Docker containers plus a couple of whole-machine gauges
// (machine_memory_bytes, machine_cpu_cores) - it has no CPU *utilization*, load average,
// or disk I/O at all. Reuses the /rootproc, /sys, /rootfs host bind mounts already added
// to the alloy service for cAdvisor's own introspection (see compose.yaml) - no new mounts
// needed.
//
// Device -> pool mapping for reading the disk I/O panels (see truenas/HARDWARE_CONFIG.md):
//   nvme0n1, nvme2n1 = "Fast" pool (NVMe mirror)      - Valheim + this monitoring stack live here
//   sda, sdb         = "Data" pool (HDD mirror, SLOW) - media only, must stay near-idle
//   nvme1n1          = boot drive, not in either pool
prometheus.exporter.unix "host" {
  procfs_path = "/rootproc"
  sysfs_path  = "/sys"
  rootfs_path = "/rootfs"
}

discovery.relabel "host_metrics" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }

  rule {
    target_label = "instance"
    replacement  = "truenas"
  }
}

prometheus.scrape "host_metrics" {
  targets         = discovery.relabel.host_metrics.output
  forward_to      = [ prometheus.remote_write.demo.receiver ]
  scrape_interval = "15s"
}

// SMART disk health (2026-09-12, see compose.yaml's smartctl-exporter service and
// ai/OBSERVABILITY.md) - scraped the same way as the dockhand/host_metrics jobs above,
// just a plain HTTP target rather than an Alloy-native prometheus.exporter.* component
// (no such component exists for smartctl_exporter). 60s matches the exporter's own
// default poll interval - scraping faster wouldn't surface fresher data, just extra load.
discovery.relabel "smartctl" {
  targets = [{
    __address__ = "grafana-alloy-smartctl-exporter:9633",
  }]

  rule {
    target_label = "job"
    replacement  = "integrations/smartctl"
  }

  rule {
    target_label = "instance"
    replacement  = "truenas"
  }
}

prometheus.scrape "smartctl" {
  targets         = discovery.relabel.smartctl.output
  forward_to      = [ prometheus.remote_write.demo.receiver ]
  scrape_interval = "60s"
}

// ###############################
// #### Logging Configuration ####
// ###############################

// Discover Docker containers and extract metadata.
discovery.docker "linux" {
  host = "unix:///var/run/docker.sock"
}

// Define a relabeling rule to create a service name from the container name.
discovery.relabel "logs_integrations_docker" {
      targets = []
  
      rule {
          source_labels = ["__meta_docker_container_name"]
          regex = "/(.*)"
          target_label = "container_name"
      }

     rule {
        target_label = "instance"
        replacement  = "truenas"
    }

  }


// Configure a loki.source.docker component to collect logs from Docker containers.
loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.linux.targets
  relabel_rules = discovery.relabel.logs_integrations_docker.rules
  forward_to = [loki.process.docker_logs.receiver]
}

// Process and filter Docker logs before sending to Loki.
// Example: Drop logs from infrastructure containers.
// Modify the regex pattern to match container names you want to exclude.
loki.process "docker_logs" {
  forward_to = [loki.write.local.receiver]

  // Anchored + fully-qualified on purpose. The previous pattern "(alloy|grafana|loki)"
  // was an unanchored substring match, so it also silently dropped
  // grafana-alloy-cadvisor, -prometheus and -smartctl-exporter (every container in this
  // stack is named grafana-alloy-*). That cost real diagnostic ability: the 2026-09-11
  // cAdvisor CPU investigation had to read `docker logs` directly because Loki had never
  // held a single cAdvisor line. Only the three self-referential log producers below are
  // excluded - they would otherwise log about ingesting their own logs.
  stage.drop {
    source     = "container_name"
    expression = "^grafana-alloy-(alloy|grafana|loki)$"
  }

  // ---- Log level detection (added 2026-09-18) --------------------------------
  // Loki's built-in level discovery only recognises the FULL level word ("Info",
  // "[INFO]", `"level":"debug"`). That covers sonarr/radarr/prowlarr ([Info]),
  // fileflows ([INFO]), autobrr (JSON), caddy and infisical - those already get
  // correct levels and MUST NOT be touched. It does NOT recognise Serilog's
  // three-letter codes ([INF]/[WRN]/[DBG]) or ANSI-coloured levels, which is why
  // sportarr (338/h), cleanuparr and most of jellyfin's volume all landed on
  // detected_level="unknown".
  //
  // Both blocks below are guarded by a LINE FILTER in the stage.match selector,
  // not just a container selector: a non-matching line must never enter the block,
  // because stage.template would then stamp an EMPTY detected_level and that
  // suppresses Loki's own detection for that line. detected_level is written as
  // STRUCTURED METADATA, never a label - a label would multiply stream count by
  // container x level.
  //
  // Not covered on purpose (no level token in the format at all): infisical-redis
  // (`*`/`#`/`-` level chars), commafeed-db + jellystat-db (postgres), tailscale,
  // valheim, and jellyfin's stack-trace continuation lines (`   at Foo.Bar(...)`),
  // which are separate log lines and would need multiline joining.

  // Serilog-style three-letter codes. Covers `[2026-09-18 21:25:14 +10:00] [INF]`
  // (sportarr), `[21:25:22] [DBG]` (jellyfin) and `[2026-09-18 21:00:10.573 INF]`
  // (cleanuparr) - i.e. the code either alone in brackets or at the end of a
  // bracketed timestamp.
  stage.match {
    // The line filter's pattern MUST be a double-quoted LogQL string. A LogQL
    // backtick raw string is valid LogQL but the match stage's parser rejects it
    // ("unexpected IDENTIFIER, expecting STRING") and Alloy then refuses to start
    // at all - confirmed live 2026-09-18, it took the whole logging pipeline down.
    // Hence an Alloy raw string (backticks) on the outside, double quotes inside.
    selector = `{instance="truenas"} |~ "\\[(?:[^\\]]* )?(TRC|VRB|DBG|INF|WRN|ERR|FTL)\\]"`

    stage.regex {
      expression = "\\[(?:[^\\]]* )?(?P<lvl>TRC|VRB|DBG|INF|WRN|ERR|FTL)\\]"
    }

    stage.template {
      source   = "lvl"
      template = "{{ if eq .lvl \"TRC\" }}trace{{ else if eq .lvl \"VRB\" }}trace{{ else if eq .lvl \"DBG\" }}debug{{ else if eq .lvl \"INF\" }}info{{ else if eq .lvl \"WRN\" }}warn{{ else if eq .lvl \"ERR\" }}error{{ else }}fatal{{ end }}"
    }

    stage.structured_metadata {
      values = { detected_level = "lvl" }
    }
  }

  // ANSI-coloured levels: jellyseerr writes `[<ESC>[32minfo<ESC>[39m][Jellyfin Sync]:`.
  // The escape sequence sits between the `[` and the word, so the word-boundary
  // match Loki uses never fires. Matched around the escape rather than stripping
  // it - stripping ANSI from the line body is a separate decision.
  stage.match {
    selector = `{instance="truenas"} |~ "\\[(?:\\x1b\\[[0-9;]*m)?(debug|info|warn|warning|error|fatal)(?:\\x1b\\[[0-9;]*m)?\\]"`

    stage.regex {
      expression = "\\[(?:\\x1b\\[[0-9;]*m)?(?P<lvl>debug|info|warn|warning|error|fatal)(?:\\x1b\\[[0-9;]*m)?\\]"
    }

    // Grafana's level colouring keys off exactly `warn`, not `warning`.
    stage.template {
      source   = "lvl"
      template = "{{ if eq .lvl \"warning\" }}warn{{ else }}{{ .lvl }}{{ end }}"
    }

    stage.structured_metadata {
      values = { detected_level = "lvl" }
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}